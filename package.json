{
	"name": "obsidian-snowflake-method",
	"version": "0.2.0",
	"description": "Plan fiction with a bilingual ten-step Snowflake Method workspace backed by portable Markdown notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"check": "npm run test && npm run build && npm run lint",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"fiction",
		"fiction-writing",
		"writing",
		"novel-planning",
		"markdown",
		"bilingual",
		"snowflake-method"
	],
	"author": "Polaris",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ZzPoLariszZ/obsidian-snowflake-method.git"
	},
	"bugs": {
		"url": "https://github.com/ZzPoLariszZ/obsidian-snowflake-method/issues"
	},
	"homepage": "https://github.com/ZzPoLariszZ/obsidian-snowflake-method#readme",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	}
}
